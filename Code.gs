/** FIXZY Apps Script backend. Set Script Property SPREADSHEET_ID to your Google Sheet ID, or bind script to the spreadsheet. */
const SHEETS={Produk:['Kode Produk','Nama Produk','Kategori','Merek','Supplier','Stok','Stok Minimum','Modal Satuan','Harga Jual'],Servis:['ID Servis','Tanggal','Nama Pelanggan','WhatsApp','Model HP','IMEI','Keluhan','Biaya Jasa','Teknisi','Karyawan ID','Catatan Internal','Sparepart JSON','Total Tagihan','Dibayar','Sisa Piutang','Status'],Penjualan:['ID Penjualan','Tanggal','Nama Pelanggan','WhatsApp','Karyawan ID','Items JSON','Diskon','Total','Dibayar','Sisa Piutang','Metode'],Pengeluaran:['ID Pengeluaran','Tanggal','Kategori','Nominal','Metode','Supplier','Karyawan ID','Keterangan'],Karyawan:['ID','Nama','Telepon','Jabatan','Upah Harian','Status','Dibuat'],Absensi:['ID','Tanggal','Karyawan ID','Nama','Status','Catatan'],Kasbon:['ID','Tanggal','Karyawan ID','Nama','Jenis','Nominal','Keterangan'],Pengaturan:['Kunci','Nilai']};
function ss(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');return id?SpreadsheetApp.openById(id):SpreadsheetApp.getActiveSpreadsheet()}
function setupSheets(){const book=ss();Object.keys(SHEETS).forEach(n=>{let sh=book.getSheetByName(n)||book.insertSheet(n);if(sh.getLastRow()===0)sh.appendRow(SHEETS[n])});return {ok:true,message:'Sheet FIXZY siap dibuat/diperiksa.'}}
function sheet(n){let s=ss().getSheetByName(n);if(!s){setupSheets();s=ss().getSheetByName(n)}return s}
function rows(n){const s=sheet(n),v=s.getDataRange().getValues();if(v.length<2)return [];const h=v[0];return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])))}
function append(n,obj){const s=sheet(n),h=SHEETS[n];s.appendRow(h.map(k=>obj[k]===undefined?'':obj[k]));}
function id(prefix){return prefix+'-'+Utilities.getUuid().slice(0,8).toUpperCase()}
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){try{setupSheets();let action=String((e.parameter.action||'ping')).split('&')[0];let q=e.parameter;switch(action){case'ping':return json({ok:true,message:'FIXZY API siap'});case'stok':return json({ok:true,data:rows('Produk')});case'servis':return json({ok:true,data:rows('Servis')});case'penjualan':return json({ok:true,data:rows('Penjualan')});case'pengeluaran':return json({ok:true,data:rows('Pengeluaran')});case'karyawan':return json({ok:true,data:rows('Karyawan')});case'pengaturan':{let o={};rows('Pengaturan').forEach(x=>o[x.Kunci]=x.Nilai);return json({ok:true,data:o})}case'absensi':{let b=q.bulan||Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM');return json({ok:true,data:rows('Absensi').filter(x=>String(x.Tanggal).slice(0,7)===b).map(x=>({...x,Tanggal:fmtDate(x.Tanggal)}))})}case'upah':return json({ok:true,data:calcPayroll(q.bulan||Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM'))});case'dashboard':{let sv=rows('Servis'),pe=rows('Penjualan'),pr=rows('Produk');return json({ok:true,ringkasan:{jumlahServis:sv.length,totalPiutangServis:sv.reduce((a,x)=>a+num(x['Sisa Piutang']),0),totalPenjualan:pe.reduce((a,x)=>a+num(x.Total),0),stokMenipis:pr.filter(x=>num(x.Stok)<=num(x['Stok Minimum'])).length}})}case'pembayaran':return json({ok:true,data:[]});default:return json({ok:false,message:'Action GET tidak dikenal: '+action})}}catch(err){return json({ok:false,message:err.message})}}
function doPost(e){try{setupSheets();let d=JSON.parse(e.postData.contents||'{}'),a=d.action||'';if(a==='createproduk'){let code=d.kodeProduk||id('PRD');append('Produk',{'Kode Produk':code,'Nama Produk':d.namaProduk,'Kategori':d.kategori,'Merek':d.merek,'Supplier':d.supplier,'Stok':num(d.stokAwal),'Stok Minimum':num(d.stokMinimum),'Modal Satuan':num(d.modal),'Harga Jual':num(d.hargaJual)});return json({ok:true,message:'Produk tersimpan',kodeProduk:code})}
if(a==='savekaryawan'){let all=rows('Karyawan'),kid=d.id||id('KRY'),obj={ID:kid,Nama:d.nama,Telepon:d.telepon,Jabatan:d.jabatan,'Upah Harian':num(d.upahHarian),Status:d.status||'Aktif',Dibuat:new Date()};let found=all.findIndex(x=>String(x.ID)===kid);if(found>=0){let s=sheet('Karyawan'),h=SHEETS.Karyawan;s.getRange(found+2,1,1,h.length).setValues([h.map(k=>obj[k]===undefined?'':obj[k])])}else append('Karyawan',obj);return json({ok:true,message:'Data karyawan tersimpan',id:kid})}
if(a==='saveabsensi'){let emp=rows('Karyawan').find(x=>String(x.ID)===String(d.karyawanId));if(!emp)throw Error('Karyawan tidak ditemukan');let sh=sheet('Absensi'),all=rows('Absensi'),idx=all.findIndex(x=>String(x.Tanggal).slice(0,10)===d.tanggal&&String(x['Karyawan ID'])===String(d.karyawanId));let obj={'ID':id('ABS'),'Tanggal':d.tanggal,'Karyawan ID':d.karyawanId,'Nama':emp.Nama,'Status':d.status,'Catatan':d.catatan};if(idx>=0)sh.getRange(idx+2,1,1,SHEETS.Absensi.length).setValues([SHEETS.Absensi.map(k=>obj[k]===undefined?'':obj[k])]);else append('Absensi',obj);return json({ok:true,message:'Absensi tersimpan'})}
if(a==='savekasbon'){let emp=rows('Karyawan').find(x=>String(x.ID)===String(d.karyawanId));if(!emp)throw Error('Karyawan tidak ditemukan');append('Kasbon',{'ID':id('KAS'),'Tanggal':d.tanggal,'Karyawan ID':d.karyawanId,'Nama':emp.Nama,'Jenis':d.jenis,'Nominal':num(d.nominal),'Keterangan':d.keterangan});return json({ok:true,message:'Kasbon/pembayaran tersimpan'})}
if(a==='savepengaturan'){let sh=sheet('Pengaturan');sh.clearContents();sh.appendRow(SHEETS.Pengaturan[0]?['Kunci','Nilai']:['Kunci','Nilai']);Object.keys(d).filter(k=>k!=='action').forEach(k=>sh.appendRow([k,d[k]]));return json({ok:true,message:'Pengaturan tersimpan'})}
if(a==='createexpense'){let eid=id('EXP');append('Pengeluaran',{'ID Pengeluaran':eid,'Tanggal':new Date(),'Kategori':d.kategori,'Nominal':num(d.nominal),'Metode':d.metode,'Supplier':d.supplier,'Karyawan ID':d.karyawanId,'Keterangan':d.keterangan});if(d.kategori==='Kasbon Karyawan'&&d.karyawanId)append('Kasbon',{'ID':id('KAS'),'Tanggal':new Date(),'Karyawan ID':d.karyawanId,'Nama':(rows('Karyawan').find(x=>String(x.ID)===String(d.karyawanId))||{}).Nama,'Jenis':'Kasbon','Nominal':num(d.nominal),'Keterangan':d.keterangan});return json({ok:true,message:'Pengeluaran tersimpan',id:eid})}
if(a==='createservis'){let parts=Array.isArray(d.spareparts)?d.spareparts:[],products=rows('Produk'),partTotal=0;parts.forEach(p=>{let ix=products.findIndex(x=>String(x['Kode Produk'])===String(p.kode));if(ix<0)throw Error('Sparepart tidak ditemukan: '+p.kode);let pr=products[ix],qty=num(p.qty);if(num(pr.Stok)<qty)throw Error('Stok tidak cukup untuk '+pr['Nama Produk']);partTotal+=qty*num(pr['Harga Jual']);updateStock(p.kode,-qty)});let total=num(d.biayaJasa)+partTotal,paid=num(d.dibayar),sid=id('SRV');append('Servis',{'ID Servis':sid,'Tanggal':new Date(),'Nama Pelanggan':d.namaPelanggan,'WhatsApp':d.wa,'Model HP':d.model,'IMEI':d.imei,'Keluhan':d.keluhan,'Biaya Jasa':num(d.biayaJasa),'Teknisi':d.teknisi,'Karyawan ID':d.karyawanId,'Catatan Internal':d.catatan,'Sparepart JSON':JSON.stringify(parts),'Total Tagihan':total,'Dibayar':paid,'Sisa Piutang':Math.max(0,total-paid),'Status':paid>=total?'Lunas':'Belum Lunas'});return json({ok:true,message:'Servis tersimpan',idServis:sid,total:total,sisaPiutang:Math.max(0,total-paid)})}
if(a==='createsale'){let items=Array.isArray(d.items)?d.items:[],total=0;items.forEach(it=>{let pr=rows('Produk').find(x=>String(x['Kode Produk'])===String(it.kode));if(!pr)throw Error('Produk tidak ditemukan');let q=num(it.qty);if(num(pr.Stok)<q)throw Error('Stok tidak cukup: '+pr['Nama Produk']);total+=num(pr['Harga Jual'])*q;updateStock(it.kode,-q)});total=Math.max(0,total-num(d.diskon));let paid=num(d.dibayar),sid=id('JUAL');append('Penjualan',{'ID Penjualan':sid,'Tanggal':new Date(),'Nama Pelanggan':d.namaPelanggan,'WhatsApp':d.wa,'Karyawan ID':d.karyawanId,'Items JSON':JSON.stringify(items),'Diskon':num(d.diskon),'Total':total,'Dibayar':paid,'Sisa Piutang':Math.max(0,total-paid),'Metode':d.metode});return json({ok:true,message:'Penjualan tersimpan',idPenjualan:sid,total:total,sisaPiutang:Math.max(0,total-paid)})}
return json({ok:false,message:'Action POST tidak dikenal: '+a})}catch(err){return json({ok:false,message:err.message})}}
function updateStock(code,delta){let s=sheet('Produk'),all=rows('Produk'),i=all.findIndex(x=>String(x['Kode Produk'])===String(code));if(i<0)throw Error('Produk tidak ditemukan');s.getRange(i+2,6).setValue(num(all[i].Stok)+delta)}
function num(v){let n=Number(v);return isFinite(n)?n:0}
function fmtDate(v){if(v instanceof Date)return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');return String(v||'').slice(0,10)}
function calcPayroll(month){let emp=rows('Karyawan'),att=rows('Absensi').filter(x=>fmtDate(x.Tanggal).slice(0,7)===month),kas=rows('Kasbon').filter(x=>fmtDate(x.Tanggal).slice(0,7)===month);return emp.map(e=>{let a=att.filter(x=>String(x['Karyawan ID'])===String(e.ID)&&x.Status==='Hadir').length, gross=a*num(e['Upah Harian']), k=kas.filter(x=>String(x['Karyawan ID'])===String(e.ID)&&x.Jenis==='Kasbon').reduce((s,x)=>s+num(x.Nominal),0), paid=kas.filter(x=>String(x['Karyawan ID'])===String(e.ID)&&x.Jenis==='Pembayaran Upah').reduce((s,x)=>s+num(x.Nominal),0);return {ID:e.ID,Nama:e.Nama,HariHadir:a,UpahKotor:gross,Kasbon:k,SudahDibayar:paid,SisaUpah:Math.max(0,gross-k-paid)}})}
